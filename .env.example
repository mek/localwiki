# .env.example - Lil-Wiki Environment Variables

# Instructions:
# 1. Copy this file to a new file named .env in the same directory.
# 2. Change the values in .env to configure your wiki instance.
# 3. Run `docker-compose up -d` to start your wiki.

# The port on your local machine that will forward to the wiki container's port (8080).
# Each running wiki instance must have a unique host port.
WIKI_HOST_PORT=8080

# The name of the Docker volume where your wiki's database will be stored.
# Each running wiki instance must have a unique volume name to keep its data separate.
WIKI_VOLUME=wiki_data
